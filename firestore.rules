rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for UserProfile
    function isValidUserProfile(data) {
      return data.id is string && data.id.size() <= 128
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && (!('name' in data) || (data.name is string && data.name.size() <= 100))
        && data.schoolClass is string && data.schoolClass.size() <= 100
        && (!('school' in data) || (data.school is string && data.school.size() <= 100))
        && (!('email' in data) || (data.email is string && data.email.size() <= 128))
        && (!('avatarSeed' in data) || (data.avatarSeed is string && data.avatarSeed.size() <= 50))
        && data.level is int && data.level >= 1 && data.level <= 10
        && data.xp is int && data.xp >= 0
        && (!('currentXP' in data) || (data.currentXP is int && data.currentXP >= 0))
        && (!('nextLevelXP' in data) || (data.nextLevelXP is int && data.nextLevelXP >= 0))
        && data.title is string && data.title.size() <= 80
        && data.debatesWon is int && data.debatesWon >= 0
        && data.fallaciesIdentified is int && data.fallaciesIdentified >= 0
        && (!('totalDebates' in data) || (data.totalDebates is int && data.totalDebates >= 0))
        && (!('unlockedBadgeIds' in data) || data.unlockedBadgeIds is list)
        && (!('streakCount' in data) || (data.streakCount is int && data.streakCount >= 0))
        && (!('lastActiveDate' in data) || (data.lastActiveDate is string && data.lastActiveDate.size() <= 10))
        && (!('lastStreakRewardDate' in data) || (data.lastStreakRewardDate is string && data.lastStreakRewardDate.size() <= 10))
        && (!('claimedQuestIds' in data) || data.claimedQuestIds is list)
        && (!('lastQuestDate' in data) || (data.lastQuestDate is string && data.lastQuestDate.size() <= 10))
        && (!('soundEnabled' in data) || data.soundEnabled is bool)
        && (!('screenShakeEnabled' in data) || data.screenShakeEnabled is bool)
        && (!('lastMatchId' in data) || (data.lastMatchId is string && data.lastMatchId.size() <= 128))
        && (!('diagnosticTestA' in data) || data.diagnosticTestA is map)
        && (!('diagnosticTestB' in data) || data.diagnosticTestB is map)
        && (!('dailyQuests' in data) || data.dailyQuests is map)
        && (!('evaluatedFallaciesHistory' in data) || data.evaluatedFallaciesHistory is list);
    }

    // Validation for LeaderboardUser
    function isValidLeaderboardUser(data) {
      return data.id is string && data.id.size() <= 128
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && (!('name' in data) || (data.name is string && data.name.size() <= 100))
        && data.schoolClass is string && data.schoolClass.size() <= 100
        && (!('avatarSeed' in data) || (data.avatarSeed is string && data.avatarSeed.size() <= 50))
        && data.level is int && data.level >= 1 && data.level <= 10
        && data.xp is int && data.xp >= 0
        && data.title is string && data.title.size() <= 80
        && data.debatesWon is int && data.debatesWon >= 0
        && data.fallaciesFound is int && data.fallaciesFound >= 0;
    }

    // Validation for PostMatchReflection (BUG-16)
    function isValidReflection(data) {
      return data is map
        && (!('opponentThoughtProvokingPoint' in data) || (data.opponentThoughtProvokingPoint is string && data.opponentThoughtProvokingPoint.size() <= 1000))
        && (!('oppositeSideOpeningIdea' in data) || (data.oppositeSideOpeningIdea is string && data.oppositeSideOpeningIdea.size() <= 1000));
    }

    // Validation for DebateMatchRecord
    function isValidDebateMatch(data) {
      return data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.topicMotion is string && data.topicMotion.size() <= 500
        && data.studentSide is string && (data.studentSide == 'pro' || data.studentSide == 'con')
        && data.outcome is string && (data.outcome == 'victory' || data.outcome == 'defeat' || data.outcome == 'draw')
        && data.studentHp is int && data.studentHp >= 0 && data.studentHp <= 100
        && data.aiHp is int && data.aiHp >= 0 && data.aiHp <= 100
        && data.xpEarned is int && data.xpEarned >= 0 && data.xpEarned <= 300
        && (!('roundsCompleted' in data) || (data.roundsCompleted is int && data.roundsCompleted >= 1 && data.roundsCompleted <= 10))
        && (!('personaName' in data) || (data.personaName is string && data.personaName.size() <= 100))
        && (!('date' in data) || (data.date is string && data.date.size() <= 30))
        && (!('timestamp' in data) || (data.timestamp is string && data.timestamp.size() <= 20))
        && (!('reflection' in data) || isValidReflection(data.reflection))
        && (!('reflectionRewardClaimed' in data) || data.reflectionRewardClaimed is bool);
    }

    // 2. USERS COLLECTION: Lưu trữ hồ sơ học sinh
    // Bảo vệ PII: Chỉ chủ sở hữu mới được đọc (get). Không cho phép list toàn bộ users.
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      // Khởi tạo hồ sơ khi lần đầu đăng nhập Google
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().id == userId
        && incoming().xp == 0
        && incoming().level == 1
        && incoming().debatesWon == 0
        && incoming().fallaciesIdentified == 0;

      // Action-Based Updates:
      // Action 1 (Profile Edit): Cập nhật thông tin cá nhân/cài đặt. XP và số trận thắng không đổi.
      // Action 2 (AI Match Evaluation Reward): Chỉ được cộng XP và thắng trận khi ghi kèm bản ghi trận đấu tương ứng qua batch write (existsAfter).
      // Action 3 (AI Fallacy Evaluation Reward): Chỉ được cộng XP khi ghi nhận tiến trình kèm số lỗi vạch được tăng đúng 1 đơn vị và XP tăng tối đa 150.
      // Action 4 (Learning Activities & Streak & Quest): Cho phép cộng XP học tập hợp lệ từ chuỗi ngày rèn luyện, nhiệm vụ, bài kiểm tra chẩn đoán.
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().id == existing().id
        && (
          // Branch 1: Profile Settings Update (XP không đổi)
          (
            incoming().xp == existing().xp
            && incoming().level == existing().level
            && incoming().debatesWon == existing().debatesWon
            && incoming().fallaciesIdentified == existing().fallaciesIdentified
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'name',
              'schoolClass',
              'school',
              'avatarSeed',
              'soundEnabled',
              'screenShakeEnabled',
              'lastActiveDate',
              'streakCount',
              'unlockedBadgeIds'
            ])
          )
          ||
          // Branch 2: Match Result Atomic Batch (Phải kèm theo bản ghi trận đấu)
          (
            'lastMatchId' in incoming()
            && isValidId(incoming().lastMatchId)
            && existsAfter(/databases/$(database)/documents/users/$(userId)/matches/$(incoming().lastMatchId))
            && incoming().xp >= existing().xp
            && incoming().xp <= existing().xp + 350
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'xp',
              'currentXP',
              'level',
              'nextLevelXP',
              'title',
              'totalDebates',
              'debatesWon',
              'unlockedBadgeIds',
              'lastActiveDate',
              'streakCount',
              'lastStreakRewardDate',
              'lastMatchId'
            ])
          )
          ||
          // Branch 3: Fallacy Result Reward & Daily Streak (XP tăng tối đa 300 sau khi AI chấm điểm và cộng streak)
          (
            incoming().fallaciesIdentified >= existing().fallaciesIdentified
            && incoming().fallaciesIdentified <= existing().fallaciesIdentified + 1
            && incoming().xp >= existing().xp
            && incoming().xp <= existing().xp + 300
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'xp',
              'currentXP',
              'level',
              'nextLevelXP',
              'title',
              'fallaciesIdentified',
              'evaluatedFallaciesHistory',
              'unlockedBadgeIds',
              'lastActiveDate',
              'streakCount',
              'lastStreakRewardDate'
            ])
          )
          ||
          // Branch 4: Hoạt động học tập (Nhiệm vụ, Điểm danh Streak, Bài test chẩn đoán, Cờ cá ngựa)
          (
            incoming().xp >= existing().xp
            && incoming().xp <= existing().xp + 300
            && incoming().level >= existing().level && incoming().level <= 10
            && incoming().debatesWon == existing().debatesWon
            && incoming().fallaciesIdentified == existing().fallaciesIdentified
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'xp',
              'currentXP',
              'level',
              'nextLevelXP',
              'title',
              'streakCount',
              'lastActiveDate',
              'lastStreakRewardDate',
              'claimedQuestIds',
              'lastQuestDate',
              'dailyQuests',
              'unlockedBadgeIds',
              'diagnosticTestA',
              'diagnosticTestB'
            ])
          )
          ||
          // Branch 5: Profile Reset Action (Đặt lại toàn bộ tiến độ cá nhân về ban đầu)
          (
            incoming().xp == 0
            && incoming().level == 1
            && incoming().debatesWon == 0
            && incoming().fallaciesIdentified == 0
            && incoming().title == 'Tập sự phản biện'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'xp',
              'currentXP',
              'level',
              'nextLevelXP',
              'title',
              'totalDebates',
              'debatesWon',
              'fallaciesIdentified',
              'unlockedBadgeIds',
              'streakCount',
              'lastActiveDate',
              'lastStreakRewardDate',
              'claimedQuestIds',
              'lastQuestDate',
              'dailyQuests',
              'evaluatedFallaciesHistory',
              'diagnosticTestA',
              'diagnosticTestB'
            ])
          )
          ||
          // Branch 6: Cập nhật tiến độ nhiệm vụ thời gian thực (không thay đổi XP)
          (
            incoming().xp == existing().xp
            && incoming().level == existing().level
            && incoming().debatesWon == existing().debatesWon
            && incoming().fallaciesIdentified == existing().fallaciesIdentified
            && (
              incoming().diff(existing()).affectedKeys().hasOnly(['dailyQuests'])
              ||
              incoming().diff(existing()).affectedKeys().hasOnly(['dailyQuests', 'lastActiveDate'])
            )
          )
          ||
          // Branch 7: Post-Match Reflection Reward (Học sinh lưu phản tư sau trận đấu được nhận đúng 25 XP)
          (
            incoming().xp == existing().xp + 25
            && (!('currentXP' in incoming()) || incoming().currentXP == existing().currentXP + 25)
            && incoming().level >= existing().level && incoming().level <= 10
            && incoming().debatesWon == existing().debatesWon
            && incoming().fallaciesIdentified == existing().fallaciesIdentified
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'xp',
              'currentXP',
              'level',
              'nextLevelXP',
              'title'
            ])
          )
        );

      allow delete: if false;

      // 3. SUBCOLLECTION: Lịch sử trận đấu của học sinh
      match /matches/{matchId} {
        allow get, list: if isOwner(userId) && isValidId(userId) && isValidId(matchId);

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(matchId)
          && isValidDebateMatch(incoming())
          && incoming().id == matchId
          && incoming().userId == userId;

        // Cập nhật phản tư sau trận đấu (BUG-16): Chỉ cho phép cập nhật reflection và reflectionRewardClaimed
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(matchId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().outcome == existing().outcome
          && incoming().xpEarned == existing().xpEarned
          && incoming().studentHp == existing().studentHp
          && incoming().aiHp == existing().aiHp
          && incoming().topicMotion == existing().topicMotion
          && incoming().studentSide == existing().studentSide
          && (!('date' in existing()) || incoming().date == existing().date)
          && incoming().diff(existing()).affectedKeys().hasOnly(['reflection', 'reflectionRewardClaimed'])
          && (!('reflection' in incoming()) || isValidReflection(incoming().reflection))
          && (
            // Không được chuyển reflectionRewardClaimed từ true về false
            (!('reflectionRewardClaimed' in existing()) || existing().reflectionRewardClaimed == false || incoming().reflectionRewardClaimed == true)
          )
          && (
            // TH1: Nhận thưởng lần đầu (false/chưa có -> true): Bắt buộc transaction phải kèm theo cộng đúng 25 XP trên user document
            (
              (!('reflectionRewardClaimed' in existing()) || existing().reflectionRewardClaimed == false)
              && ('reflectionRewardClaimed' in incoming() && incoming().reflectionRewardClaimed == true)
              && getAfter(/databases/$(database)/documents/users/$(userId)).data.xp == get(/databases/$(database)/documents/users/$(userId)).data.xp + 25
            )
            ||
            // TH2: Đã nhận thưởng rồi hoặc không nhận thưởng (chỉ cập nhật nội dung phản tư): XP không được thay đổi
            (
              (
                ('reflectionRewardClaimed' in existing() && existing().reflectionRewardClaimed == true && incoming().reflectionRewardClaimed == true)
                || (!('reflectionRewardClaimed' in incoming()) || incoming().reflectionRewardClaimed == false)
              )
              && getAfter(/databases/$(database)/documents/users/$(userId)).data.xp == get(/databases/$(database)/documents/users/$(userId)).data.xp
            )
          );
      }
    }

    // 4. LEADERBOARD COLLECTION: Bảng xếp hạng công khai toàn trường
    // KHÔNG chứa email hay PII học sinh.
    match /leaderboard/{userId} {
      allow get, list: if true;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidLeaderboardUser(incoming())
        && incoming().id == userId
        && incoming().xp == 0
        && incoming().level == 1
        && incoming().debatesWon == 0
        && incoming().fallaciesFound == 0;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidLeaderboardUser(incoming())
        && incoming().id == existing().id
        && (
          (incoming().xp >= existing().xp)
          ||
          (incoming().xp == 0 && incoming().level == 1 && incoming().debatesWon == 0 && incoming().fallaciesFound == 0)
        )
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'name',
          'schoolClass',
          'avatarSeed',
          'level',
          'xp',
          'title',
          'debatesWon',
          'fallaciesFound'
        ]);

      allow delete: if false;
    }
  }
}
